# ==========================================
# SERVER & APP CONFIGURATION
# ==========================================
NODE_ENV=development
PORT=8000
APP_NAME=Jiwasku
APP_URL=http://localhost:8000

# ==========================================
# DATABASE CONFIGURATION (e.g., PostgreSQL / MySQL)
# ==========================================
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=jiwasku_db
DB_USER=postgres
DB_PASSWORD=your_password_here

# ==========================================
# STORAGE / FILE UPLOAD CONFIGURATION
# (Untuk berkas VCF/CSV pipeline GWAS)
# ==========================================
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=700

# ==========================================
# GWiS / GWAS PIPELINE ENGINE & JOB QUEUE
# (e.g., Redis / Celery / RabbitMQ)
# ==========================================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
JOB_QUEUE_NAME=jiwasku_gwas_queue

# ==========================================
# DEFAULT GWAS PARAMETERS
# ==========================================
DEFAULT_MAF_THRESHOLD=0.05
DEFAULT_CALL_RATE=0.95
DEFAULT_NUM_PCS=3

# ==========================================
# EXTERNAL API / SERVICES (Jika ada)
# ==========================================
EXTERNAL_API_URL=https://api.example.com
EXTERNAL_API_KEY=your_api_key_here